# Supabase — copy this file to `.env` and fill in your project's values.
# Find them in the Supabase dashboard: Settings → API.
# These are the PUBLIC (anon) values and are safe to ship in a client app;
# Row Level Security is what actually protects your data.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
